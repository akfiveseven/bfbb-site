"use client";

import { ContentContainer } from "@/components/layout/ContentContainer";
// import { CenteredContainer } from "@/components/layout/CenteredContainer";
import React, { useState, useEffect } from "react";
import axios from "axios";
import { Difficulty } from "@/components/ui/Difficulty";
import { CenteredContainer } from "@/components/layout/CenteredContainer";


const StratsTable = () => {
    const [stratsData, setStratsData] = useState([]);
    const [expandedRow, setExpandedRow] = useState(null);

    useEffect(() => {
        axios
            .get("/data/Strategies.json")
            .then((res) => {
                setStratsData(res.data);
            })
            .catch((err) => console.log(err));
    }, []);

    const [selectedLevel, setSelectedLevel] = useState("All");
    const handleLevelChange = (e) => {
        setSelectedLevel(e.target.value);
    };

    //  const { stratName } = useParams();

    const filteredData =
        selectedLevel === "All"
            ? stratsData
            : stratsData.filter((item) => item.level === selectedLevel);

    /*
  useEffect(() => {
    if (stratName) {
      let index = -1;

      for (let i = 0; i < stratsData.length; i++) {
        if (stratsData[i].name === decodeURIComponent(stratName)) {
          index = stratsData[i].index;
        }
      }

      if (index != -1) {
        setExpandedRow(index);
      }
    }
  }, [stratsData]);
  */

    const handleRowClick = (index) => {
        setExpandedRow((prev) => (prev === index ? null : index));
    };

    const renderInnerTable = (methods) => {
        return (
            <table className="inner-table">
                <thead>
                    <tr>
                        <th className="font-mono">Method</th>
                        <th className="font-mono">Difficulty</th>
                    </tr>
                </thead>
                <tbody>
                    {methods.map((method, methodIndex) => (
                        <tr key={methodIndex}>
                            <td>
                                {method.videoURL !== "N/A" ? (
                                    <a
                                        href={method.videoURL}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        className="underline hover:text-[#FFEB7A]"
                                    >
                                        <>{method.name}</>
                                    </a>
                                ) : (
                                        <>{method.name}</>
                                    )}
                            </td>
                            <td>
                                <Difficulty
                                    count={method.difficulty}
                                    className="hidden md:block text-center"
                                />
                            </td>

                            {/*<td>{method.name}</td>
              <td>{method.difficulty}</td>
              <td>
                {method.videoURL !== "N/A" ? (
                  <a href={method.videoURL} target="_blank" rel="noopener noreferrer" className='underline'>Watch Video</a>
                ) : (
                  "N/A"
                )}
              </td>
              */}
                        </tr>
                    ))}
                </tbody>
            </table>
        );
    };

    return (
        <>
            <ContentContainer>
                <h1 className="text-center text-xl font-bob text-yellow">Strategies</h1>
                <div className="my-container my-table-container">
                    <div>
                        <select
                            className="text-[#000000] styled-select bg-white w-full md:w-auto"
                            id="levelSelect"
                            value={selectedLevel}
                            onChange={handleLevelChange}
                        >
                            <option value="All">All Levels</option>
                            <option value="Bikini Bottom">Bikini Bottom</option>
                            <option value="Jellyfish Fields">Jellyfish Fields</option>
                        </select>
                        <br className="md:hidden" />
                        <br className="md:hidden" />
                        <p className="md:inline md:pl-4">
                            Note: Click on a row to expand it.
                        </p>
                        <table className="my-table">
                            <thead>
                                <tr>
                                    <th className="font-bob">Strategy</th>
                                    {/*<th className='font-bob'>Category</th>*/}
                                    <th className="font-bob">Level</th>
                                    <th className="font-bob">Spatula</th>
                                </tr>
                            </thead>
                            <tbody>
                                {filteredData.map((strat, index) => (
                                    <React.Fragment key={index}>
                                        <tr
                                            onClick={() => handleRowClick(index)}
                                            className={
                                                expandedRow === index
                                                    ? "clicked hover:text-[#FFEB7A] hover:underline"
                                                    : "hover:text-[#FFEB7A] hover:underline"
                                            }
                                        >
                                            <td>{strat.name}</td>
                                            {/*<td className="ext-cols">{strat.category}</td>*/}
                                            <td className="ext-cols">{strat.level}</td>
                                            <td className="ext-cols">{strat.spatula}</td>
                                        </tr>
                                        {expandedRow === index && (
                                            <tr>
                                                <td colSpan="4">{renderInnerTable(strat.methods)}</td>
                                            </tr>
                                        )}
                                    </React.Fragment>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </ContentContainer>
        </>
    );
};

